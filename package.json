{
  "name": "haazri",
  "version": "0.1.0",
  "private": true,
  "description": "Haazri \u2014 face + location attendance and payroll for small shops. The app itself is plain HTML and vanilla JS with no build step; this package.json exists only for the test tooling.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:rules && npm run test:browser",
    "test:unit": "node --test test/unit/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project haazri-test \"node --test --test-concurrency=1 test/rules/*.test.js\"",
    "emulators": "firebase emulators:start --only firestore,auth --project haazri-test",
    "serve": "node test/serve.js",
    "test:browser": "firebase emulators:exec --only firestore,auth --project haazri-test \"node test/browser/e2e.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.0.0",
    "playwright": "1.56"
  }
}
